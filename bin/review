#!/usr/bin/env python3
"""review <ISSUE> <round> <brief> [k=1]  -> compact verdicts on stdout.

The ticket loop is one implementer, one reviewer, and again if needed (owner's rule, 2026-11-10). This runs k
reviewers (default 1) through run-model and validates each verdict, prints one line per reviewer + blocking findings,
and writes them to .autopilot/out/<ISSUE>-findings-<round>.md (input of the next implementation round).

Exit 0 = MIN_REVIEWS valid approvals and no valid "changes" verdict; 1 = changes required; 2 = not enough valid
verdicts (no eligible reviewer, invalid output, or a reviewer that modified the tree: retry later); 3 = the tree
could not be restored after a reviewer modified it (look at the worktree before anything else).

Who reviews (fail closed, whatever the caller says):
- the role's tier only: a ticket code review is Tier 2 (POOL=review, the default; review_mid / review_high are
  aliases); POOL=plan_review, premortem or milestone_review is Tier 1. Never Tier 1 or Tier 4 for a code review;
- never a model that implemented the ticket in any round (state.json `implementers`, written by run-model before each
  dispatch), on any account or harness; a reviewer of another vendor than every implementer is preferred when one is
  eligible, not required;
- k > 1 reviewers come from k different vendors; a plan review excludes the planner's vendor (EXCLUDE_VENDOR=<vendor>,
  or state.json `coordinator`);
- drawn at random weighted by the credit left on each account (lib.pool), the coordinator's own account never for a
  Tier 1/2 review unless nothing else exists;
- a verdict counts only if it parses, uses an allowed verdict, and the reviewer did not modify the tree; "approve"
  with a blocking finding or an unmet criterion counts as changes required.

No eligible reviewer: when one comes back within `review_wait_minutes` (models.json, default 90) this waits for it
(WAIT=0 disables waiting); otherwise it raises a CRITICAL alert (bin/alert, Linear project update) and exits 2
`NO_REVIEWER`. It never falls to another tier.

EXCLUDE=<key>[,<key>]  extra keys (expanded to every account of the same model id).
EXCLUDE_VENDOR=<v>[,<v>]  extra vendors.
MIN_REVIEWS=<n>  valid approvals needed, 1..k (default k).
WT=<worktree>  the reviewers run there (default: the repo).
"""
import concurrent.futures as cf, json, os, subprocess, sys, time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import autopilot_lib as lib

RM = os.path.join(lib.HERE, 'run-model')
iss, n, brief = sys.argv[1:4]
k = int(sys.argv[4]) if len(sys.argv) > 4 else 1
M = lib.find_repo()
CWD = os.environ.get('WT', M)
OUT = os.path.join(M, '.autopilot', 'out'); os.makedirs(OUT, exist_ok=True)
reg = lib.load_reg(); ad = lib.adapters(); state = lib.load_state(M)
POOL = os.environ.get('POOL', 'review')
ROLE = lib.role_of(POOL)
MIN = int(os.environ.get('MIN_REVIEWS', k))
if not 1 <= MIN <= k:
    sys.exit('review: MIN_REVIEWS must be between 1 and %d' % k)
if os.environ.get('ALLOW_MID') == '1':
    sys.exit('review: ALLOW_MID was removed by the tier policy: plan reviews are Tier 1 only (wait, or tell the owner)')
if ROLE not in lib.REVIEW_ROLES:
    sys.exit('review: POOL=%s is role %s, which never reviews' % (POOL, ROLE))
PLAN = ROLE in lib.PLAN_ROLES

impl_keys, impl_ids = lib.implementers_of(M, iss)
ex_keys = [e for e in os.environ.get('EXCLUDE', '').split(',') if e] + impl_keys
ex_vendors = [v for v in os.environ.get('EXCLUDE_VENDOR', '').split(',') if v]
if PLAN:
    coord = state.get('coordinator')
    if coord in reg['models']:
        ex_vendors.append(lib.vendor_of(reg['models'][coord], ad.get(reg['models'][coord]['cli'])))
    if not ex_vendors:
        sys.exit('review: a plan review needs the planner identity: set `coordinator` (roster key) in .autopilot/state.json or EXCLUDE_VENDOR=<vendor>')
EX = lib.expand_exclusions(reg, keys=ex_keys, vendors=ex_vendors, identities=impl_ids, ad=ad)
impl_vendors = {lib.vendor_of(reg['models'][x], ad.get(reg['models'][x]['cli'])) for x in impl_keys if x in reg['models']}


def choose(reg):
    """k reviewers; with k=1, one of another vendor than the implementers when such a reviewer is eligible."""
    if k == 1 and impl_vendors:
        other = lib.expand_exclusions(reg, vendors=sorted(impl_vendors), ad=ad)
        pick, vendors = lib.pick_reviewers(reg, [ROLE], 1, EX | other, ad)
        if pick:
            return pick, vendors
    return lib.pick_reviewers(reg, [ROLE], k, EX, ad)


window = float(reg.get('review_wait_minutes', 90)) * 60
pick, vendors = choose(reg)
while len(pick) < MIN:
    ready = lib.vendor_ready_at(reg, [ROLE], max(MIN, 1), EX, ad)
    wait = (ready - lib.now()).total_seconds() if ready else None
    if wait is not None and wait <= window and os.environ.get('WAIT') != '0':
        print(f'WAITING: no eligible {ROLE} reviewer now (Tier {"/".join(map(str, lib.roles(reg)[ROLE]))}); the next one is back at {ready.astimezone():%H:%M %Z}', flush=True)
        time.sleep(max(1, wait + 2)); reg = lib.load_reg(warn=False); pick, vendors = choose(reg); continue
    why = ('none before %s' % ready.astimezone().strftime('%a %d %b %H:%M %Z')) if ready else 'none in the roster (configuration: bin/harness check)'
    msg = (f'{ROLE} for {iss} round {n}: {len(pick)} eligible reviewer(s) of Tier {"/".join(map(str, lib.roles(reg)[ROLE]))}, need {MIN}; {why}; '
           f'excluded {sorted(EX)}')
    lib.raise_alert(M, 'review_blocked', f'{ROLE}-{iss}', f'CRITICAL: no {ROLE} reviewer for {iss}', msg,
                    {'role': ROLE, 'issue': iss, 'round': n, 'excluded': sorted(EX), 'ready': ready.isoformat() if ready else None})
    print(f'NO_REVIEWER: {msg}'); sys.exit(2)
lib.resolve_alert(M, 'review_blocked', f'{ROLE}-{iss}')


def run(x):
    out = os.path.join(OUT, f'{iss}-rev-{x}-{n}.md')
    cmd = [RM, 'run', 'review', brief, out, '--cwd', CWD, '--issue', iss, '--model', x, '--role', ROLE]
    if ex_vendors: cmd += ['--exclude-vendor', ','.join(ex_vendors)]
    p = subprocess.run(cmd, capture_output=True, text=True)
    try:
        res = json.loads(p.stdout.strip().splitlines()[-1])
    except Exception:
        res = {'status': 'error', 'raw': p.stdout[-200:]}
    return x, res, (lib.parse_json_block(out) if res.get('status') == 'ok' else None)


snap = lib.snapshot(CWD)
results = list(cf.ThreadPoolExecutor(len(pick)).map(run, pick))
restored = lib.restore(CWD, snap, f'reviewer-junk-{iss}-{n}')
if restored == 'restored':
    print('TREE RESTORED: a reviewer modified the worktree; its edits were reverted to the pre-review snapshot')
elif restored == 'history_changed':
    print('HISTORY CHANGED: a reviewer committed or moved HEAD in the worktree; nothing was rewritten automatically. Inspect `git log` and `git status` there before anything else; no verdict of this round counts'); sys.exit(3)
elif restored == 'restore_failed':
    print('TREE RESTORE FAILED: a reviewer modified the worktree and the snapshot could not be re-applied; inspect it (untracked junk in .tmp/)'); sys.exit(3)

blocking, approvals, changes, invalid = [], 0, 0, 0
for x, res, v in results:
    if res.get('reviewer_modified_tree'):
        print(f'{x}: DISCARDED (modified the tree; verdict not counted)'); invalid += 1; continue
    if not v:
        print(f"{x}: {res.get('status')} (no verdict)"); invalid += 1; continue
    status, lines = lib.validate_verdict(v)
    if status == 'invalid':
        print(f'{x}: INVALID verdict: {lines[0]}'); invalid += 1; continue
    print(f"{x}: {v.get('verdict')} -> {status} | {str(v.get('summary', ''))[:200]}")
    for s in lines:
        print(f'- [{x}] {s}'); blocking.append(f'- [{x}] {s}')
    minors = [f for f in v.get('findings', []) if f.get('severity') == 'minor']
    if minors:
        print(f'  ({len(minors)} minor)')
    if status == 'approve': approvals += 1
    else: changes += 1
open(os.path.join(OUT, f'{iss}-findings-{n}.md'), 'w').write('\n'.join(blocking) or '(none)')
if changes:
    sys.exit(1)
if approvals >= MIN:
    sys.exit(0)
print(f'INCOMPLETE: {approvals} valid approval(s), need {MIN} ({invalid} without a usable verdict); retry the missing reviewer(s)'); sys.exit(2)
