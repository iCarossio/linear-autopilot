#!/usr/bin/env python3
"""mkbrief <impl|review|plan|diag> <ISSUE> <round> <ticket.md> [findings.md]  -> prints the brief path.

Fills prompts/implement.md, prompts/review.md, prompts/plan-review.md (adversarial review of the ticket file itself) or
prompts/diagnose.md (read-only root-cause diagnosis of one scope, `SCOPE=` env text) for one ticket.
- Repo and state: the nearest `.autopilot/state.json` above the current directory (or $AUTOPILOT_REPO).
- Working directory of the ticket: $WT (a worktree) or the repo itself.
- ticket.md: first line `# Title`, then the body. A line `CHECKS: <cmd>` sets the checks (else state.json `checks`).
  An `**Acceptance**` section is extracted as the acceptance criteria.
- Review diff base: HEAD while the ticket is uncommitted (implementers never commit). When the worktree's branch is ahead
  of the project branch (a ticket committed by `finish`, then recovered with `rebase-wt`), the base is the merge-base with
  the project branch, so the review covers the committed ticket work plus the uncommitted fixes.
Templates: repo `prompts/`, overridden by `$AUTOPILOT_CONFIG_DIR/prompts/<name>.md` when present.
"""
import json, os, re, sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import autopilot_lib as lib

HOME, CONFIG_DIR, find_repo = lib.HOME, lib.CONFIG_DIR, lib.find_repo


def template(name):
    for d in (os.path.join(CONFIG_DIR, 'prompts'), os.path.join(HOME, 'prompts')):
        p = os.path.join(d, name)
        if os.path.exists(p):
            return open(p).read()
    sys.exit(f'mkbrief: template {name} not found')


kind, iss, n, tf = sys.argv[1:5]
findings = open(sys.argv[5]).read() if len(sys.argv) > 5 else '(none)'
M = find_repo()
R = os.environ.get('WT', M)
S = json.load(open(os.path.join(M, '.autopilot', 'state.json')))
T = open(tf).read()
title = T.splitlines()[0].lstrip('# ').strip()
body = '\n'.join(T.splitlines()[1:])
m = re.search(r'^CHECKS:(.*)$', T, re.M)
checks = (m.group(1).strip() if m else '') or ' && '.join(S.get('checks', [])) or 'the verification steps in the acceptance criteria'
acc = re.search(r'\*\*Acceptance\*\*(.*)', body, re.S)
acc = acc.group(1).strip() if acc else 'see ticket'
tpl = template({'impl': 'implement.md', 'review': 'review.md', 'plan': 'plan-review.md', 'diag': 'diagnose.md'}[kind])
ctx = ', '.join(os.path.join(R, c) for c in S.get('context_files', []))
base = 'HEAD'
if lib.is_git(R):
    ahead = lib.git(R, 'rev-list', '--count', '%s..HEAD' % S['branch']).stdout.strip()
    if ahead.isdigit() and int(ahead) > 0:
        base = lib.git(R, 'merge-base', S['branch'], 'HEAD').stdout.strip() or 'HEAD'
rep = {'ISSUE_ID': iss, 'ISSUE_TITLE': title, 'CWD': R, 'BRANCH': S['branch'], 'CONTEXT_FILES': ctx,
       'ISSUE_BODY': body, 'ACCEPTANCE': acc, 'FINDINGS': findings, 'CHECKS': checks, 'BASE': base, 'TICKET_PATH': os.path.abspath(tf), 'SCOPE': os.environ.get('SCOPE', '(whole ticket)')}
for k, v in rep.items():
    tpl = tpl.replace('{{' + k + '}}', v)
os.makedirs(os.path.join(M, '.autopilot', 'briefs'), exist_ok=True)
out = os.path.join(M, '.autopilot', 'briefs', f'{iss}-{kind}-{n}.md' if kind != 'diag' else f'{iss}-diag-{os.environ.get("SCOPE_ID", n)}.md')
open(out, 'w').write(tpl)
print(out)
