#!/usr/bin/env python3
"""linear-autopilot model runner. Keeps the coordinator's context small: it runs another
model's CLI, stores the full output in a file and prints ONE json line.

  run-model run <implement|review> <brief.md> <out.md> [--cwd DIR] [--issue ID | --standalone] [--exclude-vendor V[,V]]
                [--role ROLE | --pool NAME | --escalate | --no-escalate] [--round N]
                [--model KEY [--allow-tier0] | --prefer KEY] [--no-fallback] [--fallback-tier1]
  run-model pool <ROLE>                 # the draw for a role right now (candidates in draw order)
  run-model whoami [--record]           # the coordinator account detected for this session; --record writes state.json coordinator_account
  run-model smoke <KEY>                 # tiny prompt, checks the model answers
  run-model discover [--apply] [--allow-fast]   # newer ids of every versioned family per CLI; --apply smokes and switches (latest version always);
                                        # speed variants ('-fast' ids) are skipped unless the owner passes --allow-fast
  run-model health                      # show cooldowns
  run-model reset <KEY>                 # clear a cooldown
  run-model wait <ROLE> [EXCLUDE,...] [--vendors N]   # block until the role has N healthy vendors, print the keys
  run-model usage [--apply]             # exact quota + reset times per harness and account; --apply cools exhausted models until their reset,
                                        # claims a Codex weekly reset first (models.json codex_auto_reset), records the credit left per account
                                        # (weights of the draws), runs `discover --apply` once a day, and raises CRITICAL alerts
  run-model status [--json]    # every configured model: subscription and, per window (short-term, weekly, monthly), percent used and reset
  run-model alerts                      # recompute the CRITICAL alerts now (bin/alert lists and acknowledges them)
  run-model vendor <KEY>                # vendor of a roster key (anthropic, openai, ...), for reviewer diversity

Tier policy (owner's rule, 2026-11-09; lib "tier policy"): a run takes a role, and the role allows levels: implement and
fix Tier 3, --escalate Tier 2 (logged in state.json `escalations`), review Tier 2, plan_review / premortem /
milestone_review Tier 1, trivial Tier 4. Escalation is automatic (owner's rule, 2026-11-09: at most one implementation
and two fixes by a cheap model per ticket): an implement or fix run whose round (--round N, else the brief or output
name `<ISSUE>-impl-<n>.md`) is above models.json `escalate_after_round` (default 3) runs as --escalate; --no-escalate
keeps the role's own tier for a mechanical merge-only round. Legacy pool names are role aliases. There is no ordered pool: the candidates
of the role are drawn at random weighted by the credit left on each account (paid before free), the coordinator's own
account last and quota-guarded. `--model` outside the role's tier is refused (exit 4), Tier 0 only with --allow-tier0,
an `excluded` or `reserved` entry never runs, an entry that breaks vendor -> CLI is refused.

Hard rules enforced here:
- every implementer dispatched for a ticket is recorded in state.json `implementers[<ISSUE>]` BEFORE it runs (even if it
  later times out: it may have edited files), with the issue from --issue or the brief name `<ISSUE>-impl-<n>.md`;
- a review run needs a ticket identity (--issue, or brief `<ISSUE>-review|plan|diag-...`, inside a project) or --standalone
  (a pre-mortem or a repo-level review with its own exclusions); it never uses a recorded implementer, nor any key running
  the same underlying model on another account or harness, nor a vendor given by --exclude-vendor, whatever --model /
  --prefer / fallbacks say (status `excluded`, exit 4);
- a ticket code review runs a Tier 1 model only with --fallback-tier1 and --model (bin/review's logged backup when no
  Tier 2 reviewer is eligible, lib.REVIEW_FALLBACK), never on the coordinator's own account;
- a plan review (role plan_review / premortem / milestone_review, or a brief `<ISSUE>-plan-...`) is a review of the
  planner's work: the planner's vendor and identity are excluded (state.json `coordinator`, or --exclude-vendor);
- the coordinator's own account (detected from this process: adapter `coordinator_env` + `account_env`, or
  $AUTOPILOT_COORDINATOR; else state.json `coordinator_account` recorded at setup) is used only when
  nothing else can run, and only while its quota keeps `coordinator_reserve` (default 30% of the 5-hour window, 20% of
  the weekly one); below it the run is refused (`coordinator_reserve`) and a CRITICAL alert is raised.

Quota (owner's standing rule, 2026-11-09):
- an account whose WEEKLY window is exhausted (fresh reading, `usage --apply` or a quota error in a run) gets its usage reset
  claimed automatically through the adapter's `auto_reset` (bin/codex-reset --yes), once per account per weekly window,
  then one of its models is smoke-tested and its cooldowns are cleared; `"codex_auto_reset": false` in models.json turns
  it off. A 5-hour limit alone never triggers it;
- a reading older than a successful run or smoke of the account is stale: never re-applied as a cooldown;
- a vendor down on every account (or plan_review/premortem without an eligible model) after that is a CRITICAL alert:
  `CRITICAL:` on stderr, `.autopilot/alerts.jsonl`, a Linear project update; the coordinator tells the owner at once.

Roster, accounts and health: $AUTOPILOT_CONFIG_DIR/models.json. CLI invocation: harnesses/<cli>.json adapters.
"""
import datetime as dt, glob, json, os, re, shutil, subprocess, sys, tempfile, time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import autopilot_lib as lib

QUOTA = re.compile(r'rate.?limit|quota|insufficient|out of credits|credit balance|balance exhausted|spend limit|payment required|\b402\b|usage limit|\b429\b|too many requests|'
                   r'exceeded|billing|not authenticated|unauthori[sz]ed|login required|please log ?in|overloaded|\b503\b', re.I)
LIVE_QUOTA = re.compile(r'hit your (?:individual )?(?:spend|usage) limit|usage limit reached|rate limit exceeded|quota exceeded', re.I)
# A line that merely QUOTES a quota phrase (a model reading this very file, docs, tests, regexes) must not count:
# only short, plain lines without code or quote characters are taken as the CLI's own error output.
CODEY = re.compile(r'["`|\\(){}\[\]=;]|re\.compile|def |\.md:|\.py:')


def live_quota_lines(tail):
    return sum(1 for line in tail.splitlines() if len(line) < 200 and LIVE_QUOTA.search(line) and not CODEY.search(line))
WAITING = re.compile(r'press (enter|any key)|\[y/n\]|\(y/n\)|'
                     r'do you want to (proceed|continue|allow)|approve this|waiting for (your )?(input|approval|confirmation)|'
                     r'trust (this|the) (folder|directory)|select an option', re.I)
# A prompt is the CLI's own last line, never code the model printed: code lines (quotes, braces, assignments, a call
# with arguments, a type annotation) are not prompts. Seen: three codex-luna accounts cooled as `waiting_input` on
# `question=(f"Approve this plan? Agents {', '.join(plan.agents)}` in the model's own output (2026-11-10).
CODE_LINE = re.compile(r'[{}=;`"\']|\w\(\w|\w: (str|int|float|bool|list|dict|None|Any)\b|, \*,|\bdef |\breturn\b|\bimport\b|^\s*(#|//|\.\.\.)|,\s*$')
ANSI = re.compile(r'\x1b\[[0-9;?]*[A-Za-z]')
WAIT_SILENT = 30  # seconds without any new output before a prompt-looking last line counts


def waiting_prompt(tail, silent, a=None):
    """True when the CLI waits for input: nothing printed for WAIT_SILENT seconds and its last non-empty line is a
    prompt (adapter `waiting_patterns`, else WAITING) that is not code."""
    if silent < WAIT_SILENT:
        return False
    lines = [l for l in ANSI.sub('', tail).splitlines() if l.strip()]
    if not lines:
        return False
    last = lines[-1].strip()
    if len(last) > 160 or CODE_LINE.search(last):
        return False
    pats = [x for x in (a or {}).get('waiting_patterns', []) if x]
    rx = re.compile('|'.join(pats), re.I) if pats else WAITING
    return bool(rx.search(last))


now = lib.now


def quota_rx(a):
    pats = [p for p in a.get('quota_patterns', []) if p]
    return re.compile('|'.join(re.escape(p) for p in pats), re.I) if pats else None


def cmd_for(m, a, prompt, out, cwd):
    """Build the CLI command from the harness adapter. Every model runs with full rights and no sandbox;
    reviewers are read-only by instruction only (run_one flags a reviewer that changes the tree)."""
    exe = shutil.which(a.get('binary', m['cli'])) or a.get('binary', m['cli'])
    sub = {'{model}': m['model'], '{out}': out, '{prompt}': prompt, '{cwd}': cwd}
    argv = []
    for x in a['run']['argv']:
        for k, v in sub.items():
            x = x.replace(k, v)
        argv.append(x)
    return [exe] + argv, lib.effective_env(m, a), a['run'].get('output', 'stdout')


# Every model run talks caveman (owner's rule): the coordinator reads every word it prints, so filler costs twice.
# The output format the brief asks for (STATUS block, JSON verdict) and every file written stay exactly as specified.
CAVEMAN = ('Talk caveman: if a `caveman` skill is available, invoke it first. Terse, answer first, no greeting, no recap, '
           'no narration between tool calls; commands, paths, numbers and errors verbatim. Code, comments, docs and the '
           'final output format the brief asks for stay exactly as specified.')


def run_one(r, key, role, brief, out, cwd, timeout=None, m=None, probe=False):
    """probe: a candidate model id tried through `m` (discover): no cooldown, no last_ok for `key`."""
    m = m or r['models'][key]; a = lib.adapter_of(m)
    brief, out, cwd = os.path.abspath(brief), os.path.abspath(out), os.path.abspath(cwd)
    os.makedirs(os.path.dirname(out), exist_ok=True)
    prompt = f'Read the file {brief} and follow its instructions exactly. Working directory: {cwd}. ' + CAVEMAN
    t0 = time.time(); before = lib.tree_fingerprint(cwd) if role == 'review' else None
    timeout = timeout or r['timeouts_seconds'].get(role, 1800)
    if os.path.exists(out):
        os.remove(out)  # a stale file from a previous model would be judged as this run's output
    cmd, env, output_mode = cmd_for(m, a, prompt, out, cwd)
    qrx = quota_rx(a)
    text, code = supervise(cmd, cwd, timeout, r['timeouts_seconds'].get('idle', 900), out + '.log', env, qrx, a)
    if output_mode != 'file' or not os.path.exists(out) or os.path.getsize(out) == 0:
        open(out, 'w').write(text)
    body = open(out, errors='ignore').read()
    secs = round(time.time() - t0)
    is_quota = lambda s: bool(QUOTA.search(s) or (qrx and qrx.search(s)))
    if code in ('timeout', 'idle', 'waiting_input', 'quota'): status = code
    elif code == 'missing': status = 'unavailable'
    elif code != 0 and is_quota(text): status = 'quota'
    elif len(body.strip()) < 2000 and is_quota(body) and code != 0: status = 'quota'
    elif code != 0 or not body.strip(): status = 'error'
    else: status = 'ok'
    # a run that exits 0 without its required final block is a failure too (model rambled or gave up)
    tail = body[-4000:]
    if status == 'ok' and 'AUTOPILOT_OK' not in body and (
            (role == 'implement' and '-diag-' not in os.path.basename(brief)
             and not re.search(r'STATUS\W{0,6}(done|partial|blocked)', tail, re.I))
            or (role == 'implement' and '-diag-' in os.path.basename(brief) and '"verdict"' not in body)
            or (role == 'review' and '"verdict"' not in body)):
        status = 'bad_output'
    res = {'model': key, 'cli': m['cli'], 'id': m['model'], 'account': lib.account_of(m, a), 'vendor': lib.vendor_of(m, a), 'role': role,
           'status': status, 'exit': code, 'seconds': secs, 'out': out, 'chars': len(body)}
    if role == 'review' and before is not None and lib.tree_fingerprint(cwd) != before:
        res['reviewer_modified_tree'] = True
    if probe:
        return res
    if status == 'ok':
        lib.record_ok(key)
    if status in ('quota', 'unavailable'):
        reset = reset_from_text(text[-2000:]) if status == 'quota' else None
        mins = (reset - now()).total_seconds() / 60 + 2 if reset and reset > now() else (60 if status == 'quota' else 1440)
        lib.cool(key, f'{status}: {text[-200:]}', mins)
    elif status in ('timeout', 'idle') and not docker_ok():
        res['status'] = 'docker_hung'  # the environment stalled, not the model: no cooldown, stop the fallback chain
    elif status in ('timeout', 'idle', 'waiting_input', 'error', 'bad_output'):
        lib.cool(key, f'{status} exit={code}: {text[-200:]}')
    return res


def docker_ok():
    """False when a Docker daemon is installed but does not answer within 15 s (hung daemon)."""
    exe = shutil.which('docker')
    if not exe: return True
    try: return subprocess.run([exe, 'version', '--format', '{{.Server.Version}}'], capture_output=True, timeout=15, stdin=subprocess.DEVNULL).returncode == 0
    except Exception: return False


def tree_active(cwd, seconds):
    try:
        r = subprocess.run(['find', cwd, '-path', '*/node_modules', '-prune', '-o', '-path', '*/.git', '-prune', '-o',
                            '-type', 'f', '-mmin', f'-{max(1, int(seconds // 60))}', '-print', '-quit'],
                           capture_output=True, text=True, timeout=60)
        return bool(r.stdout.strip())
    except Exception:
        return False


def supervise(cmd, cwd, timeout, idle, logpath, env, qrx=None, a=None):
    """A model CLI must never block the session: stdin is closed, the process runs in its own group, and it is
    killed as soon as it asks for input, goes silent for `idle` seconds, or exceeds `timeout`."""
    import signal
    log = open(logpath, 'w')
    try:
        p = subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, start_new_session=True,
                             env={**env, 'CI': '1', 'NO_COLOR': '1', 'TERM': 'dumb', 'PYTHONDONTWRITEBYTECODE': '1'})
    except FileNotFoundError:
        log.close()
        return f'{cmd[0]} not installed', 'missing'
    t0 = last_change = time.time(); last_size = 0; reason = None
    while p.poll() is None:
        time.sleep(3)
        size = os.path.getsize(logpath)
        if size != last_size: last_size, last_change = size, time.time()
        tail = open(logpath, errors='ignore').read()[-2000:] if size else ''
        if waiting_prompt(tail, time.time() - last_change, a): reason = 'waiting_input'
        elif live_quota_lines(tail) >= 3: reason = 'quota'  # the CLI itself looping on a quota message (adapter patterns only classify the final exit)
        elif time.time() - last_change > idle:
            # silent CLI but files still changing in cwd (long build/capture in a tool call) = progress
            if tree_active(cwd, idle): last_change = time.time()
            else: reason = 'idle'
        elif time.time() - t0 > timeout: reason = 'timeout'
        if reason:
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try: os.killpg(p.pid, sig)
                except (ProcessLookupError, PermissionError): break  # group gone or reaped (macOS answers EPERM for a dead group)
                try: p.wait(10); break
                except subprocess.TimeoutExpired: pass
            break
    # Reap what the CLI left behind (`cmd &` jobs from its tool calls): they share its process group.
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try: os.killpg(p.pid, sig); time.sleep(2)
        except (ProcessLookupError, PermissionError): break
    log.close()
    return open(logpath, errors='ignore').read(), reason or p.returncode


def repo_for(brief, cwd):
    """The project of a run: $AUTOPILOT_REPO (validated), else the nearest .autopilot/state.json above the brief or cwd."""
    if os.environ.get('AUTOPILOT_REPO'):
        if not os.path.exists(lib.state_path(os.environ['AUTOPILOT_REPO'])):
            sys.exit('run-model: AUTOPILOT_REPO=%s has no .autopilot/state.json' % os.environ['AUTOPILOT_REPO'])
        return os.path.abspath(os.environ['AUTOPILOT_REPO'])
    for start in (os.path.dirname(os.path.abspath(brief)), os.path.abspath(cwd)):
        d = start
        while d != '/':
            if os.path.exists(lib.state_path(d)):
                return d
            d = os.path.dirname(d)
    return None


IMPL_ROUND = re.compile(r'.+?-impl-(\d+)\.md$')


def run_role(r, args, kind, brief, out):
    """(role, round) of a run. The role: --role, else --pool (legacy names are aliases), else implement / escalate, else
    a plan review for a `<ISSUE>-plan-` brief, else a ticket code review. An implement or fix run past round
    `escalate_after_round` (models.json, default 3) becomes `escalate` unless --no-escalate (a merge-only round)."""
    if '--role' in args: role = lib.role_of(args[args.index('--role') + 1])
    elif '--pool' in args: role = lib.role_of(args[args.index('--pool') + 1])
    elif kind == 'implement': role = 'escalate' if '--escalate' in args else 'implement'
    else: return ('plan_review' if re.match(r'.+?-plan-', os.path.basename(brief)) else 'review'), None
    if '--round' in args:
        n = args[args.index('--round') + 1]
        if not n.isdigit() or int(n) < 1: sys.exit('run-model run: --round takes a round number >= 1, got %r' % n)
        n = int(n)
    else:
        mt = IMPL_ROUND.match(os.path.basename(brief)) or IMPL_ROUND.match(os.path.basename(out))
        n = int(mt.group(1)) if mt else None
    if role in ('implement', 'fix') and n and n > int(r.get('escalate_after_round', 3)) and '--no-escalate' not in args:
        role = 'escalate'
    return role, n


def refuse(role, issue, reason, status='refused', **extra):
    print(json.dumps(dict({'status': status, 'role': role, 'issue': issue, 'reason': reason}, **extra))); sys.exit(4)


WINDOW_5H = re.compile(r'5h|300 ?min|session|5.?hour', re.I)
WINDOW_WEEK = re.compile(r'week|10080', re.I)


def coordinator_guard(r, ad, key):
    """(ok, why) before delegating to the coordinator's own account: its remaining quota, read now, must keep the
    reserve (models.json `coordinator_reserve`, default 30% of the 5-hour window and 20% of the weekly window left).
    An unreadable quota fails closed: the coordinator must never run out of credits."""
    m = r['models'][key]; a = ad[m['cli']]
    res = dict({'5h': 30, 'weekly': 20}, **(r.get('coordinator_reserve') or {}))
    ws = [w for w in usage_probe(a, lib.effective_env(m, a)) if w.get('used') is not None]
    if not ws:
        return False, 'quota of the coordinator account %s unreadable' % lib.account_key(m, a)
    low = []
    for w in ws:
        name = '5h' if WINDOW_5H.search(w['window']) else 'weekly' if WINDOW_WEEK.search(w['window']) else None
        if name and 100 - w['used'] < res[name]:
            low.append('%s %d%% left (reserve %d%%)' % (w['window'], 100 - w['used'], res[name]))
    return (False, ', '.join(low)) if low else (True, '')


def cmd_run(args):
    kind, brief, out = args[0], args[1], args[2]
    if kind not in ('implement', 'review'): sys.exit('run-model run: <implement|review>')
    cwd = args[args.index('--cwd') + 1] if '--cwd' in args else os.getcwd()
    issue = args[args.index('--issue') + 1] if '--issue' in args else lib.issue_from_brief(brief)
    repo = repo_for(brief, cwd)
    r = lib.load_reg(); ad = lib.adapters()
    role, rnd = run_role(r, args, kind, brief, out)
    if '--allow-mid' in args or os.environ.get('ALLOW_MID') == '1':
        refuse(role, issue, 'ALLOW_MID / --allow-mid was removed by the tier policy: plan reviews and pre-mortems are Tier 1 only. Wait (`run-model wait plan_review`) and tell the owner when it lasts')
    if kind == 'review' and role not in lib.REVIEW_ROLES:
        refuse(role, issue, 'a review takes role review (Tier 2) or a plan role (Tier 1); %s never reviews' % role)
    if kind == 'implement' and role in lib.REVIEW_ROLES:
        refuse(role, issue, 'role %s reviews, it never implements' % role)
    ex_vendors = [v for v in (args[args.index('--exclude-vendor') + 1] if '--exclude-vendor' in args else '').split(',') if v]
    if kind == 'review' and not (issue and repo) and '--standalone' not in args:
        print(json.dumps({'status': 'error', 'role': role, 'reason': 'a review run needs --issue <ID> inside a project with .autopilot/state.json (or a brief named <ISSUE>-review-<n>.md), or --standalone for a review that is not about a ticket'})); sys.exit(4)
    keys_, ids_ = lib.implementers_of(repo, issue) if kind == 'review' and issue and repo else ([], [])
    if role in lib.PLAN_ROLES:
        coord = lib.load_state(repo).get('coordinator') if repo else None
        if coord in r['models']:
            keys_ = keys_ + [coord]; ex_vendors.append(lib.vendor_of(r['models'][coord], ad.get(r['models'][coord]['cli'])))
        if not ex_vendors:
            print(json.dumps({'status': 'error', 'role': role, 'reason': 'a plan review needs the planner identity: `coordinator` (roster key) in .autopilot/state.json, or --exclude-vendor <vendor>'})); sys.exit(4)
    excluded = lib.expand_exclusions(r, keys=keys_, identities=ids_, vendors=ex_vendors, ad=ad) if kind == 'review' else set()
    levels = lib.roles(r)[role]
    if '--fallback-tier1' in args:
        if kind != 'review' or role not in lib.REVIEW_FALLBACK or '--model' not in args:
            refuse(role, issue, '--fallback-tier1 is only for a ticket code review with --model (bin/review draws the backup reviewer)')
        levels = levels + lib.roles(r)[lib.REVIEW_FALLBACK[role]]
        fk = args[args.index('--model') + 1]
        if fk in r['models'] and lib.on_coordinator_account(r, r['models'][fk], ad.get(r['models'][fk]['cli'])):
            refuse(role, issue, '%s is on the coordinator account: never a Tier 1 backup reviewer' % fk, model=fk)
    if role == 'escalate':
        if not (issue and repo):
            refuse(role, issue, '--escalate needs a ticket identity (--issue)')
        why = '--escalate' if '--escalate' in args else 'round %s > escalate_after_round %s' % (rnd, r.get('escalate_after_round', 3))
        print('run-model: escalate %s: Tier %s -> Tier %s (%s)' % (issue, '/'.join(map(str, lib.roles(r)['implement'])), levels[0], why), file=sys.stderr)
        lib.update_state(repo, lambda st: st.setdefault('escalations', {}).setdefault(issue, []).append(
            {'at': now().isoformat(), 'from': lib.roles(r)['implement'], 'to': levels, 'round': rnd, 'why': why}))
    if '--model' in args:
        k = args[args.index('--model') + 1]
        m = r['models'].get(k) or refuse(role, issue, 'unknown roster key %s' % k)
        a = ad.get(m['cli'])
        why = lib.refused(r, ad).get(k)
        if why: refuse(role, issue, 'roster entry %s refused by the policy: %s' % (k, why), model=k)
        exr = lib.excluded_reason(r, k, m, a)
        if exr: refuse(role, issue, '%s is excluded: %s' % (k, exr), model=k)
        lv = lib.level_of(r, m, a)
        if lv == 0 and '--allow-tier0' not in args:
            refuse(role, issue, '%s is Tier 0: never selected without the owner opt-in --allow-tier0' % k, model=k)
        if lv != 0 and lv not in levels:
            refuse(role, issue, '%s is Tier %s; role %s takes Tier %s only' % (k, lv, role, '/'.join(map(str, levels))), model=k)
        if k in excluded:
            print(json.dumps({'status': 'excluded', 'role': role, 'issue': issue, 'model': k,
                              'reason': 'implemented or planned this ticket (same underlying model on any account or harness), or an excluded vendor'})); sys.exit(4)
        keys = [k]
    else:
        keys = [k for k in lib.pool(r, role, ad) if lib.healthy(r, k) and k not in excluded]
        if '--prefer' in args:  # put one model first but keep the rest as fallback (spreads parallel runs)
            pk = args[args.index('--prefer') + 1]
            if pk in keys: keys = [pk] + [k for k in keys if k != pk]
    tried = []
    critical_check(repo)  # the coordinator sees a vendor outage on every run, not only at the heartbeat
    for k in keys:
        if k not in r['models'] or not lib.healthy(r, k) or k in excluded:  # roster edited or cooled down while this run was going
            continue
        m = r['models'][k]; a = ad.get(m['cli'])
        allowed = os.environ.get('ALLOW_IMPLEMENT', '').split(',')  # explicit per-session user exception
        if kind == 'implement' and m.get('no_implement') and k not in allowed:
            tried.append(f"{k}:no_implement"); continue
        if lib.on_coordinator_account(r, m, a):
            ok, why = coordinator_guard(r, ad, k)
            if not ok:
                tried.append(f'{k}:coordinator_reserve')
                lib.raise_alert(repo, 'coordinator_reserve', lib.account_key(m, a), 'CRITICAL: coordinator quota reserve reached',
                                'delegation to the coordinator account %s refused (%s); role %s has no other model available' % (lib.account_key(m, a), why, role),
                                {'account': lib.account_key(m, a), 'role': role, 'why': why})
                if '--model' in args:
                    refuse(role, issue, 'coordinator account reserve: ' + why, status='coordinator_reserve', model=k)
                continue
            lib.resolve_alert(repo, 'coordinator_reserve', lib.account_key(m, a))
        if kind == 'implement':
            if not (issue and repo):
                print(json.dumps({'status': 'error', 'role': role, 'reason': 'implement runs need a ticket identity: --issue <ID> or a brief named <ISSUE>-impl-<n>.md inside a project with .autopilot/state.json'})); sys.exit(4)
            lib.record_implementer(repo, issue, k, m, a or lib.adapter_of(m))
        acct = lib.account_key(m, a)
        lib.update_reg(lambda rr: rr.setdefault('last_used', {}).__setitem__(acct, now().isoformat()))
        res = run_one(r, k, 'implement' if kind == 'implement' else 'review', brief, out, cwd); tried.append(f"{k}:{res['status']}")
        res['level'] = lib.level_of(r, m, a); res['run_role'] = role
        if rnd: res['round'] = rnd
        if res['status'] == 'quota':
            after_quota(k, repo)
        if res['status'] == 'docker_hung':
            print(json.dumps({'status': 'docker_hung', 'role': role, 'tried': tried})); sys.exit(3)
        if res['status'] == 'ok' or '--no-fallback' in args:
            res['tried'] = tried; res['issue'] = issue; print(json.dumps(res)); return
        r = lib.load_reg()
    print(json.dumps({'status': 'all_failed', 'role': role, 'issue': issue, 'tried': tried, 'excluded': sorted(excluded),
                      'levels': levels})); sys.exit(2)


def smoke(r, key):
    import tempfile
    d = tempfile.mkdtemp(); b = os.path.join(d, 'brief.md'); o = os.path.join(d, 'out.md')
    open(b, 'w').write('Reply with exactly: AUTOPILOT_OK')
    res = run_one(r, key, 'review', b, o, d, timeout=r['timeouts_seconds'].get('smoke', 120))
    res['passed'] = res['status'] == 'ok' and 'AUTOPILOT_OK' in open(o, errors='ignore').read()
    return res


def after_quota(key, repo):
    """A run hit its quota: claim the account's weekly reset when the adapter has one and the window is exhausted,
    then refresh the CRITICAL alerts."""
    r = lib.load_reg(); ad = lib.adapters(); m = r['models'][key]; a = ad.get(m['cli'])
    if a and a.get('auto_reset'):
        entry = {'cli': m['cli'], 'account': lib.account_of(m, a), 'windows': usage_probe(a, lib.effective_env(m, a))}
        mark_stale(r, ad, entry)
        claim_reset(entry, ad)
    critical_check(repo)


def cmd_smoke(args):
    r = lib.load_reg(); key = args[0]
    if key not in r['models']: sys.exit(f'run-model: unknown key {key}')
    print(json.dumps(smoke(r, key)))


def sh(c, env=None, timeout=60):
    """(stdout, diagnostic or None)"""
    try:
        p = subprocess.run(c, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL, env=env or os.environ)
        return p.stdout, (None if p.returncode == 0 else f'exit {p.returncode}: {(p.stderr or p.stdout)[-200:].strip()}')
    except FileNotFoundError:
        return '', f'{c[0]} not installed'
    except subprocess.TimeoutExpired:
        return '', f'timeout after {timeout}s'
    except Exception as e:
        return '', str(e)[:200]


def list_models(a, env):
    """Model ids a harness offers (for discover). Kinds: command+regex, json_file, probe (no listing: candidate ids
    are generated and smoke-tested, see `probe_candidates`), none. Returns (ids, kind)."""
    spec = a.get('list_models', {'kind': 'none'}); kind = spec.get('kind', 'none')
    exe = shutil.which(a.get('binary', a['name'])) or a.get('binary', a['name'])
    if kind == 'command':
        found = re.findall(spec['regex'], sh([exe] + spec['argv'], env)[0], re.M)
        return ['/'.join(f) if isinstance(f, tuple) else f for f in found], kind  # several groups: provider/id
    if kind == 'json_file':
        try:
            data = lib.read_json(lib.expand_path(spec['path'], a, env))
            for part in spec.get('list', '').split('.'):
                if part: data = data[part]
            return [next((m[k] for k in spec.get('id', ['id']) if m.get(k)), None) for m in data], kind
        except Exception:
            return [], kind
    return [], kind


VER = r'(v?\d+(?:[.-]\d+)*)'


def ver(s): return tuple(int(x) for x in re.findall(r'\d+', s))


def family_rx(m):
    fam = re.escape(m['family']).replace(r'\*', VER)
    return re.compile('^' + fam + ('([-:]free)$' if lib.is_free_model(m) and m.get('tier') == 'free' else '$'))


def probe_candidates(m):
    """Next version ids of an entry whose CLI cannot list its models (Claude): the next minor, the next major (with
    and without a minor). `claude-sonnet-5-5` -> claude-sonnet-6-0, claude-sonnet-6, claude-sonnet-5-6."""
    mm = family_rx(m).match(m['model'])
    if not mm:
        return []
    v = mm.group(1); sep = '-' if '-' in v else '.'; parts = [int(x) for x in re.findall(r'\d+', v)]
    nxt = [[parts[0] + 1] + [0] * (len(parts) - 1), [parts[0] + 1]]
    if len(parts) > 1: nxt.append(parts[:-1] + [parts[-1] + 1])
    out = []
    for p_ in nxt:
        cand = m['model'][:mm.start(1)] + sep.join(map(str, p_)) + m['model'][mm.end(1):]
        if cand not in out and cand != m['model']: out.append(cand)
    return out


def probe_smoke(r, key, model_id):
    """Smoke a candidate id through `key`'s CLI and account without touching the entry (no cooldown on failure)."""
    import tempfile
    m = dict(r['models'][key], model=model_id)
    d = tempfile.mkdtemp(); b = os.path.join(d, 'brief.md'); o = os.path.join(d, 'out.md')
    open(b, 'w').write('Reply with exactly: AUTOPILOT_OK')
    res = run_one(r, key, 'review', b, o, d, timeout=r['timeouts_seconds'].get('smoke', 120), m=m, probe=True)
    return res['status'] == 'ok' and 'AUTOPILOT_OK' in open(o, errors='ignore').read()


def discover(apply, allow_fast=False):
    """Newer ids of every versioned family (`family` with a `*`) per CLI and account. With apply: smoke the newest
    candidate through the entry's own CLI and account; when it answers, every entry on that CLI with the old id moves
    to the new one, its level follows the owner's tier table when the table names the new id (else it is kept), and
    models.json `changelog` records it. Speed variants ('-fast' ids, lib.FAST_ID) are never candidates (listed in
    `skipped_fast`) unless allow_fast or the entry itself has `allow_fast`. Returns the report."""
    r = lib.load_reg(); ad = lib.adapters(); cands = {}; avail = {}; skipped = set()
    for key, m in r['models'].items():
        a = ad.get(m['cli'])
        if not a or '*' not in m.get('family', '') or not lib.installed(a): continue
        ck = (m['cli'], lib.account_of(m, a))
        if ck not in avail: avail[ck] = list_models(a, lib.effective_env(m, a))
        ids, kind = avail[ck]
        rx = family_rx(m); cur = rx.match(m['model'])
        if kind == 'probe':
            found = probe_candidates(m)
        else:
            found = [mid for mid in ids if mid and rx.match(mid) and (lib.is_free_model(m) or not lib.FREE_ID.search(mid))]
            found = [mid for mid in found if ver(rx.match(mid).group(1)) > ver(cur.group(1) if cur else '0')]
            found.sort(key=lambda mid: ver(rx.match(mid).group(1)), reverse=True)
        if not (allow_fast or m.get('allow_fast')):
            skipped.update(mid for mid in found if lib.is_fast_model(mid))
            found = [mid for mid in found if not lib.is_fast_model(mid)]
        if found and (m['cli'], m['model']) not in cands:
            cands[(m['cli'], m['model'])] = {'key': key, 'from': m['model'], 'candidates': found, 'kind': kind}
    out = {'available_counts': {f'{c}/{acc}': len(v[0]) for (c, acc), v in avail.items()},
           'upgrades': [dict(c, to=c['candidates'][0]) for c in cands.values() if c['kind'] != 'probe'],
           'probes': [c for c in cands.values() if c['kind'] == 'probe'], 'skipped_fast': sorted(skipped)}
    if apply:
        applied = []
        for c in cands.values():
            new = next((mid for mid in c['candidates'] if probe_smoke(r, c['key'], mid)), None)
            if not new: continue
            lv, entry = lib.table_level(r, new)

            def fin(rr, c=c, new=new, lv=lv):
                moved = []
                for k, m in rr['models'].items():
                    if m['cli'] == rr['models'][c['key']]['cli'] and m['model'] == c['from']:
                        old_lv = m.get('level'); m['model'] = new
                        if lib.is_fast_model(new): m['allow_fast'] = True  # reached only through the owner's --allow-fast
                        if lv is not None and lv != old_lv and not lib.forced_four(m): m['level'] = lv
                        moved.append('%s%s' % (k, '' if m.get('level') == old_lv else ' (level %s -> %s, tier table)' % (old_lv, m.get('level'))))
                rr.setdefault('changelog', []).append({'date': str(now().date()), 'change': 'discover: %s -> %s on %s (smoke ok)' % (c['from'], new, ', '.join(moved)),
                                                       'why': 'latest version of the family always (owner rule)'})
                return moved
            applied.append({'from': c['from'], 'to': new, 'keys': lib.update_reg(fin)})
        out['applied'] = applied
    lib.update_reg(lambda r: r.__setitem__('last_discovery', str(now().date())))
    return out


def cmd_discover(args):
    out = discover('--apply' in args, '--allow-fast' in args)
    for mid in out['skipped_fast']:
        print('run-model: discover skipped %s: %s' % (mid, lib.FAST_WHY), file=sys.stderr)
    for x in out.get('applied', []):
        print('run-model: upgraded %s -> %s (%s)' % (x['from'], x['to'], ', '.join(x['keys'])), file=sys.stderr)
    print(json.dumps(out))


MONTHS = {m: i + 1 for i, m in enumerate(['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'])}


def reset_from_text(text):
    """Reset time announced in a CLI message, as an aware datetime, or None. Understands ISO stamps,
    'resets Oct 25 at 3:29am (America/New_York)', 'renews on October 26 at 15:45', 'try again at 3:00 PM',
    'in 2 hours 5 minutes', 'Resets in 162h57m57s' (Antigravity). Times without a zone are local; a date-less time already past means tomorrow."""
    from zoneinfo import ZoneInfo
    t = re.sub(r'\b(resets?|renews?)\s*:', r'\1', text.lower())
    m = re.search(r'(?:reset|renew|available|again)\w*[^\n]{0,40}?(\d{4}-\d\d-\d\dt\d\d:\d\d(?::\d\d)?(?:\.\d+)?(?:z|[+-]\d\d:?\d\d))', t)
    if m: return dt.datetime.fromisoformat(m.group(1).upper().replace('Z', '+00:00'))
    m = re.search(r'(?:reset|renew|again)\w*(?: on| at)?\s+(?:([a-z]{3})[a-z]*\.? (\d{1,2})(?:st|nd|rd|th)?,?(?: \d{4})?\s+(?:at\s+)?)?(\d{1,2})(?::(\d\d))?\s*([ap]\.?m\.?)?(?:\s*\(([\w/+-]+)\))?', t)
    if m and (m.group(1) in MONTHS or m.group(1) is None) and (m.group(4) or m.group(5)):
        try: tz = ZoneInfo(m.group(6).replace('america', 'America').replace('europe', 'Europe').replace('/new_york', '/New_York')) if m.group(6) else None
        except Exception: tz = None
        local = dt.datetime.now(tz) if tz else dt.datetime.now().astimezone()
        h = int(m.group(3)) % 12 + (12 if m.group(5) and m.group(5)[0] == 'p' else 0) if m.group(5) else int(m.group(3))
        day = local.replace(month=MONTHS[m.group(1)], day=int(m.group(2))) if m.group(1) else local
        cand = day.replace(hour=h, minute=int(m.group(4) or 0), second=0, microsecond=0)
        if m.group(1) and cand < local - dt.timedelta(days=1): cand = cand.replace(year=cand.year + 1)
        elif not m.group(1) and cand <= local: cand += dt.timedelta(days=1)
        return cand
    m = next((x for x in re.finditer(r'\bin (?:(\d+) ?h(?:ours?|rs?)?)?\s*(?:(\d+) ?m(?:in(?:utes?)?)?)?\s*(?:\d+ ?s(?:ec(?:onds?)?)?)?\b', t)
              if x.group(1) or x.group(2)), None)
    if m and re.search(r'(reset|again|retry)', t):
        return now() + dt.timedelta(hours=int(m.group(1) or 0), minutes=int(m.group(2) or 0))
    return None


def screen_text(data, rows=50, cols=160):
    """The text a terminal of rows x cols shows after `data` (bytes a TUI wrote): a minimal VT renderer for the
    absolute-positioning full-screen TUIs (cursor moves, erases, scrolling). Colours, OSC/DCS/APC strings and modes are
    dropped; wide glyphs take one cell. Returns the lines, right-stripped, joined by newlines."""
    g = [[' '] * cols for _ in range(rows)]; y = x = 0
    s = data.decode('utf-8', errors='ignore'); i = 0; n = len(s)
    def scroll():
        g.pop(0); g.append([' '] * cols)
    while i < n:
        c = s[i]
        if c == '\x1b' and i + 1 < n:
            k = s[i + 1]
            if k == '[':
                j = i + 2
                while j < n and not ('@' <= s[j] <= '~'): j += 1
                if j >= n: break
                prm, fin = s[i + 2:j], s[j]; i = j + 1
                q = prm.lstrip('?>=<'); nums = [int(v) if v.isdigit() else 0 for v in q.split(';')] if q else []
                arg = lambda k, d: nums[k] if len(nums) > k and nums[k] else d
                a1 = arg(0, 1)
                if fin in 'Hf': y = min(rows - 1, arg(0, 1) - 1); x = min(cols - 1, arg(1, 1) - 1)
                elif fin == 'A': y = max(0, y - a1)
                elif fin == 'B': y = min(rows - 1, y + a1)
                elif fin == 'C': x = min(cols - 1, x + a1)
                elif fin == 'D': x = max(0, x - a1)
                elif fin == 'G': x = min(cols - 1, a1 - 1)
                elif fin == 'd': y = min(rows - 1, a1 - 1)
                elif fin == 'E': y = min(rows - 1, y + a1); x = 0
                elif fin == 'F': y = max(0, y - a1); x = 0
                elif fin == 'J':
                    mode = arg(0, 0)
                    if mode == 0: g[y][x:] = [' '] * (cols - x); [g.__setitem__(r, [' '] * cols) for r in range(y + 1, rows)]
                    elif mode == 1: g[y][:x + 1] = [' '] * (x + 1); [g.__setitem__(r, [' '] * cols) for r in range(0, y)]
                    else: g[:] = [[' '] * cols for _ in range(rows)]
                elif fin == 'K':
                    mode = arg(0, 0)
                    if mode == 0: g[y][x:] = [' '] * (cols - x)
                    elif mode == 1: g[y][:x + 1] = [' '] * (x + 1)
                    else: g[y] = [' '] * cols
                elif fin == 'X': g[y][x:x + a1] = [' '] * len(g[y][x:x + a1])
                elif fin == 'h' and prm in ('?1049', '?47', '?1047'): g[:] = [[' '] * cols for _ in range(rows)]; y = x = 0
                continue
            if k in ']P_^X':  # OSC / DCS / APC / PM / SOS: skip to BEL or ST
                j = i + 2
                while j < n and s[j] != '\x07' and not (s[j] == '\x1b' and j + 1 < n and s[j + 1] == '\\'): j += 1
                i = j + (1 if j < n and s[j] == '\x07' else 2); continue
            if k in '()*+': i += 3; continue
            i += 2; continue
        i += 1
        if c == '\r': x = 0
        elif c == '\n':
            if y == rows - 1: scroll()
            else: y += 1
        elif c == '\b': x = max(0, x - 1)
        elif c == '\t': x = min(cols - 1, (x // 8 + 1) * 8)
        elif c >= ' ' and c != '\x7f':
            if x >= cols:
                x = 0
                if y == rows - 1: scroll()
                else: y += 1
            g[y][x] = c; x += 1
    return '\n'.join(''.join(r).rstrip() for r in g)


def tui_capture(argv, env, steps, timeout=60, rows=50, cols=160, cwd=None):
    """Drive an interactive CLI in a pseudo-terminal and return (screen text, diagnostic or None). `steps` (adapter
    `usage.steps`): {"wait_for": REGEX, "timeout": S} waits until the rendered screen matches, {"sleep": S},
    {"type": TEXT} types it, {"key": "enter"|"esc"|"tab"|"up"|"down"}. Local slash commands only: nothing here may be
    sent to a model. The process is killed at the end; the screen is what the last step saw."""
    import pty, select, signal, fcntl, termios, struct
    keys = {'enter': b'\r', 'esc': b'\x1b', 'tab': b'\t', 'up': b'\x1b[A', 'down': b'\x1b[B'}
    try: pid, fd = pty.fork()
    except OSError as e: return '', 'pty: %s' % e
    if pid == 0:
        try:
            if cwd: os.chdir(cwd)
            e = dict(env or os.environ); e['TERM'] = 'xterm-256color'; e['COLUMNS'] = str(cols); e['LINES'] = str(rows)
            os.execvpe(argv[0], argv, e)
        finally: os._exit(127)
    buf = bytearray(); start = time.time(); diag = None
    try:
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', rows, cols, 0, 0))
        def pump(sec):
            end = time.time() + sec
            while time.time() < end:
                r, _, _ = select.select([fd], [], [], 0.1)
                if not r: continue
                try: d = os.read(fd, 65536)
                except OSError: return False
                if not d: return False
                buf.extend(d)
                if b'\x1b[6n' in d: os.write(fd, b'\x1b[%d;1R' % rows)  # cursor position report
                if b'\x1b[c' in d or b'\x1b[0c' in d: os.write(fd, b'\x1b[?62;22c')  # device attributes
            return True
        for st in steps:
            if time.time() - start > timeout: diag = 'tui timeout after %ss' % timeout; break
            if 'wait_for' in st:
                rx = re.compile(st['wait_for'], re.M); lim = time.time() + float(st.get('timeout', 20))
                while not rx.search(screen_text(bytes(buf), rows, cols)):
                    if time.time() > lim: diag = 'tui: %r never appeared' % st['wait_for']; break
                    if not pump(0.5): diag = 'tui: process exited'; break
                if diag: break
            elif 'sleep' in st: pump(float(st['sleep']))
            elif 'if_screen' in st:  # {"if_screen": REGEX, "type": TEXT | "key": NAME}: only when the screen shows it (e.g. a trust prompt)
                if re.search(st['if_screen'], screen_text(bytes(buf), rows, cols), re.M):
                    if 'type' in st: os.write(fd, st['type'].encode())
                    elif 'key' in st: os.write(fd, keys[st['key']])
                    pump(0.8)
            elif 'type' in st:
                for ch in st['type']: os.write(fd, ch.encode()); pump(0.04)
            elif 'key' in st: os.write(fd, keys[st['key']]); pump(0.3)
    except OSError as e:
        diag = 'tui: %s' % e
    finally:
        try: os.kill(pid, signal.SIGKILL); os.waitpid(pid, 0)
        except Exception: pass
        try: os.close(fd)
        except Exception: pass
    return screen_text(bytes(buf), rows, cols), diag


VIBE_BILLING = r"""
import asyncio, json
from vibe.core.config.vibe_schema import DEFAULT_MISTRAL_API_ENV_KEY, DEFAULT_MISTRAL_API_BASE
from vibe.core.platform_auth._mistral import api_key_credentials
from vibe.app_server._billing import HttpBillingGateway
r = asyncio.run(HttpBillingGateway().read(api_base=DEFAULT_MISTRAL_API_BASE, credentials=api_key_credentials(DEFAULT_MISTRAL_API_ENV_KEY), with_budget=True))
print(json.dumps({'subscription': r.subscription and r.subscription.model_dump(), 'budget': r.budget and r.budget.model_dump()}))
"""


def interpreter_of(exe):
    """The Python a console script runs with (its shebang), or None."""
    try:
        line = open(os.path.realpath(exe), 'rb').readline().decode(errors='ignore').strip()
    except OSError:
        return None
    if not line.startswith('#!'): return None
    parts = line[2:].split()
    return parts[0] if parts and 'python' in parts[0] else (parts[1] if len(parts) > 1 and parts[0].endswith('env') and 'python' in parts[1] else None)


def probe_dir():
    """Empty directory the TUI probes start in: CLIs that ask to trust a folder ask once about this one, never about a project."""
    d = os.path.join(lib.CONFIG_DIR, 'probe'); os.makedirs(d, exist_ok=True)
    return d


def unknown(note):
    return [{'window': 'unknown', 'used': None, 'reset': '', 'note': note}]


def usage_probe(a, env):
    """Quota windows of one harness on one account, read without spending model quota. Each window carries
    `observed` (when the reading was taken). Kinds: command+regex, codex_sessions, none. A probe that fails or
    matches nothing returns one `unknown` window with the diagnostic: never an empty list."""
    spec = a.get('usage', {'kind': 'none'}); kind = spec.get('kind', 'none'); out = []
    exe = shutil.which(spec.get('binary') or a.get('binary', a['name'])) or spec.get('binary') or a.get('binary', a['name'])  # usage.binary: a probe through another CLI (pi -> opencode)
    if kind in ('command', 'tui'):
        if kind == 'tui':
            for _try in range(2):  # a cold TUI start can miss its first prompt: one retry
                txt, diag = tui_capture([exe] + spec.get('argv', []), env, spec['steps'], timeout=spec.get('timeout', 60), cwd=probe_dir())
                if re.search(spec['regex'], txt, re.M | (re.S if 'S' in spec.get('flags', '') else 0)): break
        else:
            txt, diag = sh([exe] + spec['argv'], env, timeout=90)
        flags = re.M | (re.S if 'S' in spec.get('flags', '') else 0) | (re.I if 'I' in spec.get('flags', '') else 0)
        for mt in re.finditer(spec['regex'], txt, flags):
            g = dict(zip(spec['groups'], mt.groups()))
            try:
                used = int(g['used']) if 'used' in g else 100 - int(g['remaining'])
                if not g.get('window'): raise KeyError('window')
            except (KeyError, ValueError, TypeError):
                return unknown('usage regex groups must capture window and an integer used|remaining on every match: %r' % (g,))
            rt = reset_from_text(g['reset_text']) if g.get('reset_text') else None
            reset = g.get('reset_iso') or (rt.isoformat() if rt else '')
            name = g['window'].strip() + (' (%s)' % g['period'].strip() if g.get('period') and g['period'].strip() else '')
            w = {'window': name, 'used': used, 'reset': reset, 'observed': now().isoformat()}
            if g.get('plan'): w['plan'] = g['plan'].strip()
            out.append(w)
        if not out:
            return unknown(f"usage command gave no parsable window ({diag or 'regex matched nothing'}): {txt[-120:].strip()!r}" if txt else f'usage command failed: {diag}')
    elif kind == 'codex_sessions':
        root = lib.expand_path(spec['path'], a, env)
        logs = sorted(glob.glob(os.path.join(root, '*/*/*/*.jsonl')), key=os.path.getmtime)
        best, best_t = None, None  # the newest rate_limits EVENT among the recent sessions, not the newest file
        for path in logs[-8:]:
            line = next((l for l in reversed(open(path, errors='ignore').read().splitlines()) if '"rate_limits"' in l), None)
            if not line: continue
            try: ev = json.loads(line)
            except Exception: continue
            rl = ev
            while isinstance(rl, dict) and 'rate_limits' not in rl: rl = next((v for v in rl.values() if isinstance(v, dict) and '"rate_limits"' in json.dumps(v)), None)
            rl = rl and rl['rate_limits']
            if not rl: continue
            ts = ev.get('timestamp') or (ev.get('payload') or {}).get('timestamp') if isinstance(ev, dict) else None
            try: t = lib.parse_time(ts) if isinstance(ts, str) else dt.datetime.fromtimestamp(float(ts) if ts else os.path.getmtime(path), dt.timezone.utc)
            except Exception: t = dt.datetime.fromtimestamp(os.path.getmtime(path), dt.timezone.utc)
            if best_t is None or t > best_t: best, best_t = rl, t
        if best:
            for w in ('primary', 'secondary'):
                if best.get(w):
                    name = f"{best[w]['window_minutes']}min"
                    out.append({'window': spec.get('windows', {}).get(name, name), 'used': round(best[w]['used_percent']),
                                'reset': dt.datetime.fromtimestamp(best[w]['resets_at'], dt.timezone.utc).isoformat(), 'observed': best_t.isoformat()})
        if not out:
            return unknown(f'no rate_limits record in the last sessions under {root}' if logs else f'no session logs under {root}')
    elif kind == 'opencode_limits':
        # `opencode api` asks a private local server (--standalone, so the account of this env) for the OpenCode Go
        # allowance of the signed-in Console workspace: rolling (5 h), weekly and monthly percent used with reset times.
        txt, diag = sh([exe] + spec['argv'], env, timeout=60)
        try: data = (json.loads(txt) or {}).get('data')
        except ValueError: return unknown(f"opencode usage limits unreadable ({diag or 'not JSON'}): {txt[-120:].strip()!r}")
        if not data: return unknown('opencode: not signed in to an OpenCode Console workspace (`opencode auth login`)' + (f' ({diag})' if diag else ''))
        names = spec.get('windows', {})
        for k, w in (data.get('go') or {}).items():
            if not isinstance(w, dict) or w.get('percent') is None: continue
            ra = w.get('resetsAt')
            out.append({'window': names.get(k, k), 'used': round(w['percent']), 'plan': spec.get('plan', 'OpenCode Go'), 'observed': now().isoformat(),
                        'reset': dt.datetime.fromtimestamp(ra / 1000, dt.timezone.utc).isoformat() if ra else ''})
        for b in data.get('budgets') or []:
            if isinstance(b, dict) and b.get('percent') is not None:
                ra = b.get('resetsAt')
                out.append({'window': 'budget %s' % (b.get('name') or b.get('period') or ''), 'used': round(b['percent']), 'observed': now().isoformat(),
                            'reset': dt.datetime.fromtimestamp(ra / 1000, dt.timezone.utc).isoformat() if ra else ''})
        if not out: return unknown('opencode: no OpenCode Go allowance on workspace %s (free models only)' % ((data.get('workspace') or {}).get('name') or '?'))
    elif kind == 'vibe_billing':
        # Mistral's billing API through Vibe's own Python and stored sign-in: the monthly Vibe budget (percent used,
        # reset) and the plan name. Private Vibe modules: an upgrade that moves them reads as `unknown`, never as 0%.
        py = interpreter_of(exe)
        if not py: return unknown(f'vibe: cannot find the Python behind {exe}')
        txt, diag = sh([py, '-I', '-c', VIBE_BILLING], env, timeout=30)
        try: d = json.loads(txt.strip().splitlines()[-1])
        except (ValueError, IndexError): return unknown(f"vibe billing unreadable ({diag or 'not JSON'}): {txt[-120:].strip()!r}")
        b = (d.get('budget') or {}).get('vibe_budget'); plan = (d.get('subscription') or {}).get('plan_name')
        if not b: return unknown('vibe: no Vibe budget on this account (plan %s; /v1/billing/budget needs the see_org_inference_usage permission)' % (plan or '?'))
        out.append({'window': spec.get('window', 'monthly'), 'used': round(b['usage_percentage']), 'reset': b.get('reset_at') or '', 'observed': now().isoformat(),
                    **({'plan': plan.title() if plan and plan.isupper() else plan} if plan else {})})
    else:
        return unknown(spec.get('note', 'no usage probe for this harness'))
    return out


def usage(r, ad):
    """Usage per (harness, account) for every account present in the roster, probed in parallel (a TUI probe takes
    10-20 s), listed in roster order."""
    from concurrent.futures import ThreadPoolExecutor
    jobs = []; seen = set()
    for key, m in r['models'].items():
        a = ad.get(m['cli'])
        if not a: continue
        acc = lib.account_of(m, a)
        if (m['cli'], acc) in seen: continue
        seen.add((m['cli'], acc))
        jobs.append((m['cli'], acc, a, lib.effective_env(m, a)))
    with ThreadPoolExecutor(max_workers=8) as ex:
        probes = [ex.submit(usage_probe, a, env) for _, _, a, env in jobs]
        return [{'cli': cli, 'account': acc, 'windows': f.result()} for (cli, acc, _, _), f in zip(jobs, probes)]


def account_keys(r, ad, cli, account):
    return [k for k, m in r['models'].items() if m['cli'] == cli and ad.get(cli) and lib.account_of(m, ad[cli]) == account]


def window_keys(r, ad, entry, window):
    """Roster keys of the entry's account that a quota window applies to (adapter `usage.window_groups`)."""
    groups = ad[entry['cli']].get('usage', {}).get('window_groups')
    for k in account_keys(r, ad, entry['cli'], entry['account']):
        if groups and not any(re.search(wr, window, re.I) and re.search(mr, r['models'][k]['model'], re.I) for wr, mr in groups.items()):
            continue
        yield k


def mark_stale(r, ad, entry):
    """Flag exhausted readings older than a successful run or smoke of a key they apply to (`stale`, `last_ok`): the
    account demonstrably had quota after the reading was taken (e.g. Codex session logs still say 100% after a reset)."""
    out = []
    for w in entry['windows']:
        if w.get('used') is None or w['used'] < 100 or not w.get('observed'):
            continue
        lo = lib.last_ok(r, list(window_keys(r, ad, entry, w['window'])))
        if lo and lo > lib.parse_time(w['observed']):
            w['stale'] = True; w['last_ok'] = lo.isoformat()
            out.append({'cli': entry['cli'], 'account': entry['account'], 'window': w['window'], 'observed': w['observed'], 'last_ok': w['last_ok']})
    return out


def auto_reset_enabled(r):
    return r.get('codex_auto_reset', True) and os.environ.get('AUTOPILOT_NO_AUTORESET') != '1'


def claim_reset(entry, ad):
    """Redeem one usage reset for an account whose reset window (adapter `auto_reset.window`, `weekly` for Codex) is
    exhausted by a fresh reading, then smoke one of its models and clear the account's cooldowns when it answers.
    At most one attempt per account per window, recorded in models.json `resets[<cli>/<account>]` before the script
    runs, so a crash never redeems twice. A 5-hour window never triggers it. The script keeps its own guards (it
    refuses unless the window is at 100%, and stops on any unexpected screen). None when there is nothing to claim."""
    a = ad[entry['cli']]; spec = a.get('auto_reset')
    if not spec:
        return None
    win = spec.get('window', 'weekly')
    w = next((w for w in entry['windows'] if w.get('window') == win and w.get('used') is not None and w['used'] >= 100
              and not w.get('stale') and w.get('reset') and lib.parse_time(w['reset']) > now()), None)
    if not w:
        return None
    acct = '%s/%s' % (entry['cli'], entry['account'])
    r = lib.load_reg()
    if not auto_reset_enabled(r):
        return {'account': acct, 'result': 'disabled'}
    prev = r.get('resets', {}).get(acct)
    if prev and abs((lib.parse_time(prev['window_reset']) - lib.parse_time(w['reset'])).total_seconds()) < 12 * 3600:
        return dict(prev, account=acct, repeated=True)  # already tried in this window, whatever the result
    rec = {'window': win, 'window_reset': w['reset'], 'at': now().isoformat(), 'result': 'running'}
    lib.update_reg(lambda rr: rr.setdefault('resets', {}).__setitem__(acct, rec))
    argv = [x.replace('{bin}', lib.HERE).replace('{account}', entry['account']) for x in spec['argv']]
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=spec.get('timeout', 240), stdin=subprocess.DEVNULL,
                           env={**os.environ, 'AUTOPILOT_NO_AUTORESET': '1'})
        code, text = p.returncode, (p.stdout or '') + (p.stderr or '')
    except (OSError, subprocess.TimeoutExpired) as e:
        code, text = -1, str(e)
    last = (text.strip().splitlines() or [''])[-1][:160]
    if code == 0:
        r = lib.load_reg()
        keys = account_keys(r, ad, entry['cli'], entry['account'])
        sm = smoke(r, keys[0]) if keys else {'passed': False, 'status': 'no model'}
        if sm['passed']:
            lib.update_reg(lambda rr: [rr['health'].pop(k, None) for k in keys])
            rec['result'] = 'redeemed, smoke ok (%s), cooldowns cleared' % keys[0]
        else:
            rec['result'] = 'redeemed, smoke failed (%s: %s)' % (keys[0] if keys else '-', sm.get('status'))
    elif re.search(r'redeem menu did not appear|no reset', text, re.I):
        rec['result'] = 'no reset available: ' + last
    elif code == 3:
        rec['result'] = 'refused: ' + last
    else:
        rec['result'] = 'failed (exit %s): %s' % (code, last)
    rec['transcript_tail'] = text[-600:]
    lib.update_reg(lambda rr: rr.setdefault('resets', {}).__setitem__(acct, rec))
    print('run-model: auto-reset %s: %s' % (acct, rec['result']), file=sys.stderr)
    return dict(rec, account=acct)


def reset_note(r, ad, acct):
    cli = acct.split('/', 1)[0]
    if not (ad.get(cli) or {}).get('auto_reset'):
        return 'no reset mechanism for this harness'
    if not auto_reset_enabled(r):
        return 'auto-reset disabled (models.json codex_auto_reset)'
    rec = r.get('resets', {}).get(acct)
    if rec:
        return '%s (%s)' % (rec['result'], rec['at'][:16])
    return 'not attempted: the reset window is not exhausted (5-hour limit, or no fresh reading)'


CHECKED_ROLES = (('implement', 1), ('review', 1), ('plan_review', 1), ('premortem', 1), ('milestone_review', 1))


def critical_check(repo):
    """Raise, refresh or resolve the CRITICAL alerts run-model owns: a vendor whose every account in the roles is down
    on quota (after the resets were tried), and a role with no eligible model (Tier 1 plan roles exclude the
    coordinator's vendor; the coordinator's own account never counts for Tier 1/2). An outage shorter than
    `alert_min_outage_minutes` (default 60), or a role empty by configuration, is not one. Prints one `CRITICAL:` line
    per active alert on stderr; a new alert also posts a Linear project update when state.json has a project.
    Returns the active alerts (every kind, including those raised elsewhere)."""
    r = lib.load_reg(); ad = lib.adapters(); t = now()
    st = lib.load_state(repo) if repo else {}
    coord = r['models'].get(st.get('coordinator') or '')
    coord_vendor = lib.vendor_of(coord, ad.get(coord['cli'])) if coord and ad.get(coord['cli']) else None
    min_out = float(r.get('alert_min_outage_minutes', 60))
    until = lambda ks: min(lib.parse_time(r['health'][k]['until']) for k in ks)
    members = {role: lib.candidates(r, role, ad) for role, _ in CHECKED_ROLES}
    by_vendor = {}
    for k in dict.fromkeys(k for ks in members.values() for k in ks):
        m = r['models'][k]
        by_vendor.setdefault(lib.vendor_of(m, ad[m['cli']]), []).append(k)
    blocked = {}
    for role, n in CHECKED_ROLES:
        ex = lib.expand_exclusions(r, vendors=[coord_vendor], ad=ad) if role in lib.PLAN_ROLES and coord_vendor else set()
        ready = lib.vendor_ready_at(r, [role], n, ex, ad)
        if ready is not None and ready > t:
            blocked[role] = ready
    found = {}
    for v, ks in sorted(by_vendor.items()):
        if any(lib.healthy(r, k) for k in ks) or not any(r['health'][k]['reason'].startswith('quota') for k in ks):
            continue
        earliest = until(ks)
        if (earliest - t).total_seconds() < min_out * 60:
            continue
        accts = sorted({lib.account_key(r['models'][k], ad[r['models'][k]['cli']]) for k in ks})
        roles_ = sorted(role for role, mk in members.items() if set(mk) & set(ks))
        resets = {acc: reset_note(r, ad, acc) for acc in accts}
        bl = [p for p in sorted(blocked) if p in roles_]
        found[('vendor_out', v)] = {
            'title': 'CRITICAL: %s out of quota' % v,
            'message': '%s out of quota on every account (%s); blocked pools: %s; earliest reset %s; resets: %s' % (
                v, ', '.join(accts), ', '.join(bl) or 'none', earliest.astimezone().strftime('%a %d %b %H:%M %Z'),
                '; '.join('%s: %s' % kv for kv in resets.items())),
            'details': {'vendor': v, 'accounts': accts, 'resets': resets, 'pools': roles_, 'blocked_pools': bl,
                        'earliest_reset': earliest.isoformat()}}
    covered = {p for d in found.values() for p in d['details']['blocked_pools']}
    for role, ready in sorted(blocked.items()):
        if role in covered or (ready - t).total_seconds() < min_out * 60:
            continue
        down = [k for k in members[role] if not lib.healthy(r, k)]
        tiers = '/'.join(map(str, lib.roles(r)[role]))
        found[('pool_blocked', role)] = {
            'title': 'CRITICAL: %s has no eligible model' % role,
            'message': '%s has no eligible model (Tier %s%s) until %s: %s cooling down' % (
                role, tiers, ', not %s' % coord_vendor if role in lib.PLAN_ROLES and coord_vendor else '',
                ready.astimezone().strftime('%a %d %b %H:%M %Z'), ', '.join(down)),
            'details': {'pool': role, 'cooling': down, 'earliest_reset': ready.isoformat()}}

    def merge(al):
        new = []
        for a in al:
            if a.get('kind') in ('vendor_out', 'pool_blocked') and not a.get('resolved_at') and (a['kind'], a['key']) not in found:
                a['resolved_at'] = t.isoformat()
        for (kind, key), d in found.items():
            cur = next((a for a in al if a['kind'] == kind and a['key'] == key and not a.get('resolved_at')), None)
            if cur:
                cur.update(message=d['message'], details=d['details'], updated_at=t.isoformat())
            else:
                al.append({'id': '%s-%s' % (t.strftime('%Y%m%d-%H%M'), key), 'level': 'CRITICAL', 'kind': kind, 'key': key,
                           'at': t.isoformat(), 'title': d['title'], 'message': d['message'], 'details': d['details']})
                new.append(al[-1])
        return new, [a for a in al if not a.get('resolved_at')]
    if not found and not os.path.exists(lib.alerts_path(repo)):
        return []
    new, active = lib.update_alerts(repo, merge)
    pid = st.get('project_id') or ''
    for a in new:
        if not pid or pid.startswith('<'):
            continue
        body = '%s\n\n%s\n\nRaised by run-model at %s. The coordinator keeps running on the other vendors; nothing that needs %s can run until the reset.' % (
            a['title'], a['message'], a['at'][:16], a['key'])
        out, diag = sh([os.path.join(lib.HERE, 'linear'), 'project-update', pid, body])
        lib.update_alerts(repo, lambda al, a=a, diag=diag: [x.__setitem__('linear', diag or 'posted') for x in al if x['id'] == a['id']])
    for a in active:
        print('CRITICAL: %s (alert %s; bin/alert list)' % (a['message'], a['id']), file=sys.stderr)
    return active


def cmd_usage(args):
    r = lib.load_reg(); ad = lib.adapters(); u = usage(r, ad); apply = '--apply' in args
    stale = [s for e in u for s in mark_stale(r, ad, e)]
    resets = []
    if apply:
        for entry in u:
            res = claim_reset(entry, ad)
            if res: resets.append(res)
        if any(not x.get('repeated') and x['result'] != 'disabled' for x in resets):
            r = lib.load_reg()  # a redeemed reset + smoke records last_ok: the reading that triggered it is stale now
            stale = [s for e in u for s in mark_stale(r, ad, e)]
    for s in stale:
        print('run-model: stale reading skipped: %s %s %s 100%% observed %s, but a model of it succeeded at %s' % (
            s['cli'], s['account'], s['window'], s['observed'][:16], s['last_ok'][:16]), file=sys.stderr)
    cooled, cleared = [], []
    for entry in u:
        known = [w for w in entry['windows'] if w['used'] is not None and not w.get('stale')]
        if not known: continue
        # Aggregate per model key, not per window: the longest exhausted reset wins, and a cooldown is cleared only
        # when EVERY window that applies to the key is under quota with a reading newer than the cooldown.
        per_key = {}
        for w in known:
            for k in window_keys(r, ad, entry, w['window']):
                per_key.setdefault(k, []).append(w)
        declared = set((ad[entry['cli']].get('usage', {}).get('windows') or {}).values())  # windows this probe is known to report
        for k, ws in per_key.items():
            full = [w for w in ws if w['used'] >= 100]
            exhausted = [w for w in full if w['reset'] and lib.parse_time(w['reset']) + dt.timedelta(minutes=2) > now()]
            if exhausted:
                until = max(lib.parse_time(w['reset']) for w in exhausted) + dt.timedelta(minutes=2)
                h = r['health'].get(k)
                if apply and not (h and lib.parse_time(h['until']) >= until):  # never shorten a longer cooldown
                    lib.cool(k, "quota: %s %s %s exhausted, resets %s (usage)" % (entry['cli'], entry['account'], '/'.join(w['window'] for w in exhausted), max(w['reset'] for w in exhausted)),
                             (until - now()).total_seconds() / 60, windows=[w['window'] for w in exhausted])
                cooled.append(k)
                continue
            if full: continue  # exhausted without a usable reset: keep whatever cooldown exists
            h = r['health'].get(k)
            if not (h and h['reason'].startswith('quota') and h.get('set_at')): continue
            fresh = {w['window'] for w in ws if lib.parse_time(w['observed']) > lib.parse_time(h['set_at'])}
            responsible = set(h.get('windows') or []) or declared  # a cooldown from a quota error names no window: every declared window must be fresh
            if fresh and responsible <= fresh:
                cleared.append(k)
                if apply: lib.update_reg(lambda rr, k=k: rr['health'].pop(k, None))
    seen = {}
    for entry in u:  # credit left per account, for the weighted draws (lib.weight): the most used fresh window wins
        ws = [w['used'] for w in entry['windows'] if w.get('used') is not None and not w.get('stale')]
        if ws: seen['%s/%s' % (entry['cli'], entry['account'])] = {'used': max(ws), 'at': now().isoformat()}
    if seen: lib.update_reg(lambda rr: rr.setdefault('usage_seen', {}).update(seen))
    upgrades = None
    if apply and os.environ.get('AUTOPILOT_NO_DISCOVER') != '1' and r.get('last_discovery') != str(now().date()):
        upgrades = discover(True)  # latest version always: once a day from the heartbeat's `usage --apply`
        for x in upgrades.get('applied', []):
            print('run-model: upgraded %s -> %s (%s)' % (x['from'], x['to'], ', '.join(x['keys'])), file=sys.stderr)
    alerts = critical_check(lib.find_repo(required=False)) if apply else []
    print(json.dumps({'usage': u, 'exhausted_until_reset': sorted(set(cooled)), 'stale_quota_cooldowns_cleared': sorted(set(cleared) - set(cooled)),
                      'stale_readings_skipped': stale, 'resets': resets, 'critical': [a['id'] for a in alerts], 'applied': apply,
                      'discovery': upgrades}))


def window_kind(name):
    """short | weekly | monthly | other, from a window name as the probes report it (5h, rolling, Current session,
    Current week (all models), weekly, monthly, budget ..., Gemini Models (Weekly Limit))."""
    n = name.lower()
    if re.search(r'month|budget', n): return 'monthly'
    if re.search(r'week', n): return 'weekly'
    if re.search(r'\b\d+\s*(h|hr|hour|min)|session|rolling|5h|daily|day|hour', n): return 'short'
    return 'other'


def fmt_reset(iso):
    if not iso: return '-'
    try: t = lib.parse_time(iso)
    except Exception: return iso
    d = t - now()
    if d.total_seconds() <= 0: return 'now'
    h = int(d.total_seconds() // 3600)
    left = '%dd%02dh' % (h // 24, h % 24) if h >= 24 else '%dh%02dm' % (h, int(d.total_seconds() % 3600 // 60))
    return '%s (in %s)' % (t.astimezone().strftime('%a %d %b %H:%M'), left)


def status_rows(r, ad, u):
    """One row per roster model: subscription, plan, account, then the windows that apply to it grouped short/weekly/monthly."""
    by = {(e['cli'], e['account']): e for e in u}
    rows = []
    for k, m in r['models'].items():
        a = ad.get(m['cli'])
        if not a: continue
        acc = lib.account_of(m, a); e = by.get((m['cli'], acc)) or {'windows': []}
        mine = [w for w in e['windows'] if k in set(window_keys(r, ad, e, w['window'] if w.get('window') else ''))] if e['windows'] else []
        wins = {'short': None, 'weekly': None, 'monthly': None}; extra = []; notes = []; plan = m.get('plan')
        for w in mine:
            if w.get('plan') and not plan: plan = w['plan']
            if w.get('used') is None: notes.append(w.get('note') or 'unknown'); continue
            kind = window_kind(w['window'])
            slot = kind if kind in wins and wins[kind] is None else None
            item = {'window': w['window'], 'used': w['used'], 'reset': w.get('reset') or '', 'observed': w.get('observed'), 'stale': bool(w.get('stale'))}
            if slot: wins[slot] = item
            else: extra.append(item)
        h = r['health'].get(k); cooled = bool(h and lib.parse_time(h['until']) > now())
        rows.append({'key': k, 'cli': m['cli'], 'model': m['model'], 'account': m.get('account_label') or acc, 'subscription': m.get('subscription') or '?',
                     'plan': plan or '', 'windows': wins, 'other_windows': extra, 'notes': notes,
                     'cooldown_until': h['until'] if cooled else None, 'cooldown_reason': h['reason'] if cooled else None})
    return rows


def cmd_status(args):
    r = lib.load_reg(); ad = lib.adapters(); u = usage(r, ad)
    for e in u: mark_stale(r, ad, e)
    rows = status_rows(r, ad, u)
    if '--json' in args: print(json.dumps(rows)); return
    def cell(w):
        if not w: return '-'
        return '%3d%% -> %s%s' % (w['used'], fmt_reset(w['reset']), ' STALE' if w['stale'] else '')
    print('%-24s %-9s %-34s %-12s | %-34s | %-34s | %s' % ('model', 'cli', 'account / plan', 'subscription', 'short-term (5h/session)', 'weekly', 'monthly'))
    for x in rows:
        who = ('%s (%s)' % (x['account'], x['plan']) if x['plan'] and x['plan'] not in x['account'] else x['account'])[:34]
        print('%-24s %-9s %-34s %-12s | %-34s | %-34s | %s' % (x['key'][:24], x['cli'], who, x['subscription'], cell(x['windows']['short']), cell(x['windows']['weekly']), cell(x['windows']['monthly'])))
        for w in x['other_windows']: print('%-24s %-9s   also: %s' % ('', '', '%s %s' % (w['window'], cell(w))))
        for n in x['notes']: print('%-24s %-9s   note: %s' % ('', '', n[:150]))
        if x['cooldown_until']: print('%-24s %-9s   COOLDOWN until %s: %s' % ('', '', lib.parse_time(x['cooldown_until']).astimezone().strftime('%a %d %H:%M'), (x['cooldown_reason'] or '')[:100]))


def cmd_wait(args):
    """Sleep until the role (or legacy pool name) has an eligible healthy model, then print the keys picked (one per
    vendor, `--vendors N`, default 1). EXCLUDE keys (comma list) are expanded to every account and harness of the same
    model. Put it in front of the run that needs the role (`run-model wait review T-1-impl-keys && ...`) so work
    restarts the minute a model resets."""
    pool_name = args[0]
    ex = [x for x in (args[1].split(',') if len(args) > 1 and not args[1].startswith('--') else []) if x]
    n = int(args[args.index('--vendors') + 1]) if '--vendors' in args else 1
    while True:
        r = lib.load_reg(); ad = lib.adapters()
        EX = lib.expand_exclusions(r, keys=ex, ad=ad)
        pick, _ = lib.pick_reviewers(r, [pool_name], n, EX, ad)
        if len(pick) >= n: print(','.join(pick)); return
        ready = lib.vendor_ready_at(r, [pool_name], n, EX, ad)
        if ready is None: sys.exit('run-model wait: %s has fewer than %d eligible vendor(s) by configuration (bin/harness check)' % (pool_name, n))
        time.sleep(max(30, min(120, (ready - now()).total_seconds() + 5)))  # recheck often: cooldowns can be reset by hand


if __name__ == '__main__':
    a = sys.argv[1:]
    if not a: print(__doc__); sys.exit(1)
    if a[0] == 'run': cmd_run(a[1:])
    elif a[0] == 'smoke': cmd_smoke(a[1:])
    elif a[0] == 'discover': cmd_discover(a[1:])
    elif a[0] == 'usage': cmd_usage(a[1:])
    elif a[0] == 'status': cmd_status(a[1:])
    elif a[0] == 'wait': cmd_wait(a[1:])
    elif a[0] == 'alerts': print(json.dumps([x['id'] for x in critical_check(lib.find_repo(required=False))]))
    elif a[0] == 'health': print(json.dumps(lib.load_reg()['health'], indent=2))
    elif a[0] == 'reset': lib.update_reg(lambda r: r['health'].pop(a[1], None)); print('ok')
    elif a[0] == 'vendor':
        r = lib.load_reg(); m = r['models'].get(a[1]) or sys.exit(f'unknown key {a[1]}'); print(lib.vendor_of(m))
    elif a[0] == 'whoami':
        ca = lib.detect_coordinator()
        if not ca: sys.exit('run-model whoami: coordinator not detected (no adapter coordinator_env set in this process; AUTOPILOT_COORDINATOR=<cli>[/<account>])')
        r = lib.load_reg(warn=False); ad = lib.adapters()
        out = {'cli': ca[0], 'account': ca[1], 'keys': [k for k, m in r['models'].items() if ad.get(m['cli']) and lib.on_coordinator_account(r, m, ad[m['cli']], ca)],
               'detected_at': now().isoformat()}
        if '--record' in a:
            repo = lib.find_repo()
            lib.update_state(repo, lambda st: st.__setitem__('coordinator_account', out))
        print(json.dumps(out))
    elif a[0] == 'pool':
        r = lib.load_reg(); print(json.dumps(lib.pool(r, a[1])))
    else: print(__doc__); sys.exit(1)
