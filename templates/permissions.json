{
  "_comment": "Permission rules the autopilot needs to run unattended. Setup step 0 merges them into ~/.claude/settings.json (permissions.allow) with the user's approval, before anything else starts. Each harness script is listed under both path spellings (~ and the absolute home; init replaces {HOME} with the user's home, since rules do not expand $HOME), because rules match the start of the command line. Never add rules for actions that need a per-use owner decision: publishing a website, merging to the default branch, opening a PR, deleting branches or worktrees, paying for credits.",
  "permissions": {
    "allow": [
      "Bash(~/.claude/skills/autopilot-run/bin/run-model *)",
      "Bash({HOME}/.claude/skills/autopilot-run/bin/run-model *)",
      "Bash(~/.claude/skills/autopilot-run/bin/review *)",
      "Bash({HOME}/.claude/skills/autopilot-run/bin/review *)",
      "Bash(~/.claude/skills/autopilot-run/bin/mkbrief *)",
      "Bash({HOME}/.claude/skills/autopilot-run/bin/mkbrief *)",
      "Bash(~/.claude/skills/autopilot-run/bin/finish *)",
      "Bash({HOME}/.claude/skills/autopilot-run/bin/finish *)",
      "Bash(~/.claude/skills/autopilot-run/bin/rebase-wt *)",
      "Bash({HOME}/.claude/skills/autopilot-run/bin/rebase-wt *)",
      "Bash(~/.claude/skills/autopilot-run/bin/state *)",
      "Bash({HOME}/.claude/skills/autopilot-run/bin/state *)",
      "Bash(~/.claude/skills/autopilot-run/bin/eta *)",
      "Bash({HOME}/.claude/skills/autopilot-run/bin/eta *)",
      "Bash(~/.claude/skills/autopilot-run/bin/linear *)",
      "Bash({HOME}/.claude/skills/autopilot-run/bin/linear *)",
      "Bash(~/.claude/skills/autopilot-run/bin/docker-up *)",
      "Bash({HOME}/.claude/skills/autopilot-run/bin/docker-up *)",
      "Bash(~/.claude/skills/autopilot-run/bin/docker-reap *)",
      "Bash({HOME}/.claude/skills/autopilot-run/bin/docker-reap *)",
      "Bash(git worktree add *)",
      "Bash(git push origin autopilot/*)",
      "Bash(git -c credential.helper= -c credential.helper='!gh auth git-credential' push *)",
      "Bash(docker ps *)",
      "Bash(docker inspect *)",
      "Bash(caffeinate *)",
      "Bash(npm ci *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
