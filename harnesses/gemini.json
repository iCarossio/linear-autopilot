{
  "name": "gemini",
  "binary": "gemini",
  "vendor": "google",
  "doc": "Google Gemini CLI. Untested in the pools so far: smoke it before adding it to a pool.",
  "run": {
    "argv": ["-p", "{prompt}", "-m", "{model}", "--yolo"],
